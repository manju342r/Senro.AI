# Supabase Configuration (Frontend & Backend Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# The following keys are managed per-user via the /dashboard/settings UI 
# and stored securely in the Supabase `user_settings` table.
# However, if you are testing locally without the database, you can use these:
VITE_BRIGHT_DATA_KEY=your_bright_data_web_unlocker_token
VITE_HINDSIGHT_API_KEY=your_vectorize_hindsight_api_key
VITE_RESEND_API_KEY=your_resend_api_key
VITE_LLM_API_KEY=your_featherless_or_openai_api_key
